[Unit]
Description=Ecosoft CRM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/ecosoftcrm
EnvironmentFile=/etc/ecosoftcrm.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ecosoftcrm /var/backups/ecosoftcrm /var/lib/ecosoftcrm/uploads

[Install]
WantedBy=multi-user.target
